# e2b orchestrator location
#
# Cloud (e2b.dev): leave E2B_DOMAIN blank (defaults to e2b.app)
# Self-host (e2b-dev/infra): set E2B_DOMAIN to the domain of your
# orchestrator (the one you pointed at the API server), e.g.
#   E2B_DOMAIN=e2b.example.com
E2B_DOMAIN=

# Orchestrator auth
#
# Both are accepted by the self-host orchestrator
# (packages/auth/pkg/auth/middleware.go). Pick ONE:
#
#   E2B_API_KEY    team-level, e2b_*** format, sent as X-API-Key
#   E2B_ACCESS_TOKEN  user-level,  sk_e2b_*** format, sent as
#                    Authorization: Bearer sk_e2b_...
#
# Cloud (e2b.dev): grab from https://e2b.dev/dashboard?tab=keys
#
# Self-host: the key is generated LOCALLY by your cluster's
# `make prep-cluster` (or `make seed-db`) step
# (packages/db/scripts/seed/postgres/seed-db.go). The script prints
# both values to stdout -- copy the "Team API Key: e2b_***" into
# E2B_API_KEY, or "Access Token: sk_e2b_***" into E2B_ACCESS_TOKEN.
# No e2b.cloud account is required for self-host.
E2B_API_KEY=
E2B_ACCESS_TOKEN=

PORT=3000

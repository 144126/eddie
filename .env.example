# e2b (self-host) or e2b cloud
# E2B_DOMAIN is the domain of the e2b orchestrator. For e2b cloud, leave blank
# (defaults to e2b.app). For a self-hosted cluster (e2b-dev/infra), set it to
# the domain you pointed at the API server, e.g. e2b.example.com
E2B_DOMAIN=

# E2B_API_KEY is the cloud e2b API key (e2b_***) when using e2b cloud.
# For a self-hosted cluster, use E2B_ACCESS_TOKEN instead with the
# orchestrator JWT (find it in your cloud provider's secrets manager:
# GCP Secrets Manager -> e2b-* prefix, or AWS Secrets Manager -> <prefix>-
# cloudflare / supabase-jwt-secrets). The SDK uses whichever is set.
E2B_API_KEY=
E2B_ACCESS_TOKEN=

PORT=3000
